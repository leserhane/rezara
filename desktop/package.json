{
  "name": "optimum-optic-desktop",
  "version": "1.0.0",
  "description": "Optimum Optic ERP - application de bureau (Windows)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.optimumoptic.erp",
    "productName": "Optimum Optic",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "build/icon.ico"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Optimum Optic"
    }
  }
}
