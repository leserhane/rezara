# Endpoint that receives { email } POST requests from the early-access form.
# Leave unset during development — the form works and shows success states
# without it, it just doesn't send the address anywhere yet.
NEXT_PUBLIC_SUBSCRIBE_ENDPOINT=

# Optional analytics — leave unset to ship with no tracking at all.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
