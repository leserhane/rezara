{
  "name": "titsuit",
  "compatibility_date": "2026-09-01",
  // Static site. The Worker only runs for the museum's guided-tour API,
  // which keeps its bookings in the Tours Durable Object.
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/hiddenmuseum/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [{ "name": "TOURS", "class_name": "Tours" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tours"] }]
}
